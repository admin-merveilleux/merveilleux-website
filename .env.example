# ─── Database ─────────────────────────────────────────────────
# Neon PostgreSQL connection string
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URI=

# ─── Payload CMS ──────────────────────────────────────────────
# Secret key for JWT signing (min 32 chars)
PAYLOAD_SECRET=

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

